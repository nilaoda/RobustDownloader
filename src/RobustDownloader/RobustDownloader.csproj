<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>RobustDownloader</AssemblyName>
        <RootNamespace>RobustDownloader</RootNamespace>
        <Version>0.0.4</Version>
        <Product>RobustDownloader</Product>
        <Title>RobustDownloader</Title>
        <Description>RobustDownloader desktop download manager</Description>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <LangVersion>preview</LangVersion>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <Target Name="GenerateReleaseTagSource" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <_GenFile>$(IntermediateOutputPath)ReleaseTag.g.cs</_GenFile>
        </PropertyGroup>
        <!-- Windows: use cmd echo -->
        <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
              Command="cmd /c echo namespace RobustDownloader.Services;^&gt; &quot;$(_GenFile)&quot;" />
        <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
              Command="cmd /c echo internal static partial class ReleaseTagHolder^&gt;&gt; &quot;$(_GenFile)&quot;" />
        <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
              Command="cmd /c echo {^&gt;&gt; &quot;$(_GenFile)&quot;" />
        <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
              Command="cmd /c echo     internal const string Value = &quot;$(ReleaseTag)&quot;;^&gt;&gt; &quot;$(_GenFile)&quot;" />
        <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
              Command="cmd /c echo }^&gt;&gt; &quot;$(_GenFile)&quot;" />
        <!-- macOS/Linux: use printf -->
        <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
              Command="printf 'namespace RobustDownloader.Services;\ninternal static partial class ReleaseTagHolder\n{\n    internal const string Value = &quot;%s&quot;;\n}\n' '$(ReleaseTag)' > &quot;$(_GenFile)&quot;" />
        <ItemGroup>
            <Compile Include="$(_GenFile)" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="RobustDownloader" />
        <TrimmerRootAssembly Include="Avalonia.Controls" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
        <PackageReference Include="Lucide.Avalonia" Version="0.2.12" />
        <PackageReference Include="ShadUI" Version="0.2.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    </ItemGroup>
</Project>
