<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>RobustDownloader</AssemblyName>
        <RootNamespace>RobustDownloader</RootNamespace>
        <Version>0.0.6</Version>
        <Product>RobustDownloader</Product>
        <Title>RobustDownloader</Title>
        <Description>RobustDownloader desktop download manager</Description>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <LangVersion>preview</LangVersion>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <Target Name="GenerateReleaseTagSource" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <_GenFile>$(IntermediateOutputPath)ReleaseTag.g.cs</_GenFile>
        </PropertyGroup>
        <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
              Command="pwsh -NoProfile -Command &quot;Set-Content -Path '$(_GenFile)' -Value 'namespace RobustDownloader.Services%3B','internal static partial class ReleaseTagHolder','{','    internal const string Value = &quot;&quot;$(ReleaseTag)&quot;&quot;%3B','}' -Encoding UTF8&quot;" />
        <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
              Command="printf 'namespace RobustDownloader.Services;\ninternal static partial class ReleaseTagHolder\n{\n    internal const string Value = &quot;%s&quot;;\n}\n' '$(ReleaseTag)' > &quot;$(_GenFile)&quot;" />
        <ItemGroup>
            <Compile Include="$(_GenFile)" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="Lang\Strings*.resx" />
        <AdditionalFiles Include="Lang\Strings*.resx" />
        <AdditionalFiles Include="**\*.axaml" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RobustDownloader.Generators\RobustDownloader.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="RobustDownloader" />
        <TrimmerRootAssembly Include="Avalonia.Controls" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
        <PackageReference Include="Lucide.Avalonia" Version="0.2.12" />
        <PackageReference Include="ShadUI" Version="0.2.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    </ItemGroup>
</Project>
