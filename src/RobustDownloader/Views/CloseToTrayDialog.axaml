<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobustDownloader.ViewModels"
             x:Class="RobustDownloader.Views.CloseToTrayDialog"
             x:DataType="vm:CloseToTrayDialogViewModel">
    <Border Padding="26,24,26,22" Width="520">
        <StackPanel Spacing="20">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Message}"
                           Foreground="{DynamicResource MutedColor}"
                           FontSize="14"
                           LineHeight="20"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <CheckBox Content="{Binding DoNotAskAgainText}"
                      IsChecked="{Binding DoNotAskAgain}"/>

            <Grid ColumnDefinitions="*,Auto,10,Auto,10,Auto" Margin="0,6,0,0">
                <Button Grid.Column="1"
                        Content="{Binding CancelText}"
                        MinWidth="88"
                        Padding="16,8"
                        HorizontalContentAlignment="Center"
                        Click="Cancel_Click"/>
                <Button Grid.Column="3"
                        Content="{Binding ExitText}"
                        MinWidth="96"
                        Padding="16,8"
                        HorizontalContentAlignment="Center"
                        Classes="Destructive"
                        Click="Exit_Click"/>
                <Button Grid.Column="5"
                        Content="{Binding MinimizeText}"
                        MinWidth="132"
                        Padding="18,8"
                        HorizontalContentAlignment="Center"
                        Classes="Primary"
                        Click="Minimize_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
