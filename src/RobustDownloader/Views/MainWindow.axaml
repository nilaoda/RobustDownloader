<shad:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobustDownloader.ViewModels"
             xmlns:models="using:RobustDownloader.Models"
             xmlns:views="using:RobustDownloader.Views"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
             x:Class="RobustDownloader.Views.MainWindow"
             x:DataType="vm:MainWindowViewModel"
             Title="{Binding WindowTitle}"
             Width="1180" Height="720"
             MinWidth="980" MinHeight="560"
             WindowStartupLocation="CenterScreen"
             Icon="/Assets/app-icon.png">
    <shad:Window.Hosts>
        <shad:DialogHost x:Name="PART_DialogHost" Manager="{Binding DialogManager}"/>
        <shad:ToastHost Manager="{Binding ToastManager}" Position="BottomRight" MaxToasts="5"/>
    </shad:Window.Hosts>

    <shad:Window.Resources>
        <views:DownloadStatusBrushConverter x:Key="StatusBackgroundConverter"/>
        <views:DownloadStatusBrushConverter x:Key="StatusForegroundConverter" Variant="Foreground"/>
    </shad:Window.Resources>

    <shad:Window.Styles>
        <Style Selector="Button">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryColor50}"/>
            <Setter Property="SelectionForegroundBrush" Value="{x:Null}"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.FieldValue">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ComboBox.ToolbarComboBox">
            <Setter Property="Width" Value="86"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.QueueFilterComboBox">
            <Setter Property="Width" Value="132"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ToolbarButton">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ToolbarWideButton">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ToolbarIconButton">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style Selector="Button.QueueFilterButton">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.ToolbarText">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.StatusBadge">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.StatusBadgeText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.TaskTreeNode">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}"/>
        </Style>
        <Style Selector="Button.TaskTreeNode:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderColor30}"/>
        </Style>
        <Style Selector="Button.TaskTreeNode.selected">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor10}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
        </Style>
        <Style Selector="Button.RootTaskTreeNode">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.ChildTaskTreeNode">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style Selector="Button.TaskTreeDisclosure">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}"/>
        </Style>
        <Style Selector="Button.TaskTreeDisclosure:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderColor30}"/>
        </Style>
        <Style Selector="TextBlock.TaskTreeNodeLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.TaskTreeDisclosure">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}"/>
        </Style>
    </shad:Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="Primary ToolbarWideButton" Click="BtnAdd_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="Plus" Size="16"/>
                            <TextBlock Text="{DynamicResource Main.NewTask}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ToolbarIconButton" Click="BtnStart_Click" IsEnabled="{Binding IsAnyTaskSelected}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <lucide:LucideIcon Kind="Play" Size="14"/>
                            <TextBlock Text="{DynamicResource Main.Start}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ToolTip.Tip>
                            <TextBlock Text="{DynamicResource Main.Start}"/>
                        </ToolTip.Tip>
                    </Button>
                    <Button Classes="ToolbarIconButton" Click="BtnStop_Click" IsEnabled="{Binding IsAnyTaskSelected}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <lucide:LucideIcon Kind="Square" Size="14"/>
                            <TextBlock Text="{DynamicResource Main.Stop}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ToolTip.Tip>
                            <TextBlock Text="{DynamicResource Main.Stop}"/>
                        </ToolTip.Tip>
                    </Button>
                    <Button Classes="Destructive ToolbarIconButton" Click="BtnDelete_Click" IsEnabled="{Binding IsAnyTaskSelected}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <lucide:LucideIcon Kind="Trash2" Size="14"/>
                            <TextBlock Text="{DynamicResource Main.Delete}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ToolTip.Tip>
                            <TextBlock Text="{DynamicResource Main.Delete}"/>
                        </ToolTip.Tip>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      ColumnDefinitions="Auto,18,Auto,8,Auto,10,Auto,10,Auto,10,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="ToolbarText"
                               Text="{Binding GlobalSpeedDisplay}"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2"
                               Classes="ToolbarText"
                               Text="{DynamicResource Main.Concurrency}"
                               Foreground="{DynamicResource MutedColor}"/>
                    <ComboBox Grid.Column="4"
                              Classes="ToolbarComboBox"
                              ItemsSource="{Binding ConcurrencyOptions}"
                              SelectedItem="{Binding MaxConcurrency}"/>
                    <Button Grid.Column="6" Content="{DynamicResource Main.StartAll}" Classes="ToolbarWideButton" Command="{Binding StartAllCommand}"/>
                    <Button Grid.Column="8" Content="{DynamicResource Main.StopAll}" Classes="ToolbarWideButton" Command="{Binding StopAllCommand}"/>
                    <Button Grid.Column="10" Classes="ToolbarIconButton" Click="BtnSettings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <lucide:LucideIcon Kind="Settings" Size="14"/>
                            <TextBlock Text="{DynamicResource Main.Settings}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto">
            <Border x:Name="TaskTreePane"
                    Grid.Column="0"
                    IsVisible="{Binding IsTaskTreePaneVisible}"
                    Width="{Binding TaskTreePaneWidth}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource CardBackgroundColor}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Height="74"
                            Padding="14,12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="SectionTitle" Text="{DynamicResource TaskTree.Title}"/>
                            <TextBlock Text="{Binding ActiveTaskTreeFilterText}"
                                       Foreground="{DynamicResource MutedColor}"
                                       FontSize="12"
                                       Height="18"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="8,10">
                        <ItemsControl ItemsSource="{Binding TaskTreeNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:TaskTreeNode">
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="24,*">
                                            <Button Grid.Column="0"
                                                    Classes="TaskTreeDisclosure"
                                                    Tag="{Binding}"
                                                    IsVisible="{Binding HasChildren}"
                                                    Click="TaskTreeDisclosure_Click">
                                                <TextBlock Classes="TaskTreeDisclosure"
                                                           Text="{Binding ExpansionGlyph}"/>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="TaskTreeNode RootTaskTreeNode"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Tag="{Binding}"
                                                    Click="TaskTreeNode_Click">
                                                <TextBlock Classes="TaskTreeNodeLabel"
                                                           Text="{Binding Label}"/>
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Children}"
                                                      IsVisible="{Binding IsExpanded}"
                                                      Margin="28,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="models:TaskTreeNode">
                                                    <Button Classes="TaskTreeNode ChildTaskTreeNode"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Tag="{Binding}"
                                                            Click="TaskTreeNode_Click">
                                                        <TextBlock Classes="TaskTreeNodeLabel"
                                                                   Text="{Binding Label}"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    IsVisible="{Binding IsTaskTreePaneVisible}"
                    Width="5"
                    Background="Transparent"
                    Cursor="SizeWestEast"
                    PointerPressed="TaskTreeResizeHandle_PointerPressed"
                    PointerMoved="TaskTreeResizeHandle_PointerMoved"
                    PointerReleased="TaskTreeResizeHandle_PointerReleased"
                    PointerCaptureLost="TaskTreeResizeHandle_PointerCaptureLost">
                <Border Width="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource BorderColor}"/>
            </Border>

            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Background="{DynamicResource BackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto,12,Auto,*,Auto,8,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Classes="SectionTitle" Text="{DynamicResource Main.Queue}"/>
                            <TextBlock Text="{Binding TabInfo}"
                                       Foreground="{DynamicResource MutedColor}"
                                       FontSize="12"/>
                        </StackPanel>

                        <ComboBox Grid.Column="2"
                                  Classes="QueueFilterComboBox"
                                  ItemsSource="{Binding TaskListScopes}"
                                  SelectedItem="{Binding SelectedTaskListScope}"/>

                        <Button Grid.Column="4"
                                Content="{Binding TaskTreePaneButtonText}"
                                Classes="QueueFilterButton"
                                HorizontalAlignment="Right"
                                Command="{Binding ToggleTaskTreePaneCommand}"/>

                        <Button Grid.Column="6"
                                Content="{Binding DetailPaneButtonText}"
                                Classes="QueueFilterButton"
                                HorizontalAlignment="Right"
                                Command="{Binding ToggleDetailPaneCommand}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="TaskGrid"
                              IsVisible="{Binding HasVisibleTasks}"
                              ItemsSource="{Binding VisibleTasks}"
                              SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              SelectionChanged="TaskGrid_SelectionChanged"
                              x:CompileBindings="False">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Main.CopyUrl}" Click="CopyUrl_Click"/>
                                <MenuItem Header="{DynamicResource Main.CopyFileName}" Click="CopyFileName_Click"/>
                                <MenuItem Header="{DynamicResource Main.CopySavePath}" Click="CopySavePath_Click"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource Main.OpenFolder}" Click="OpenFolder_Click"/>
                                <MenuItem Header="{DynamicResource Main.ReDownload}" Click="ReDownload_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Column.FileName}" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTemplateColumn Header="{DynamicResource Column.Status}" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:DownloadTask">
                                        <Border Classes="StatusBadge"
                                                Background="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}">
                                            <TextBlock Classes="StatusBadgeText"
                                                       Text="{Binding StatusLabel}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Column.Progress}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:DownloadTask">
                                        <Grid Height="18">
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"/>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0:0.0}%}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Column.Speed}" Binding="{Binding Speed}" Width="105"/>
                            <DataGridTextColumn Header="{DynamicResource Column.Eta}" Binding="{Binding EtaText}" Width="105"/>
                            <DataGridTextColumn Header="{DynamicResource Column.Size}" Binding="{Binding FileSize}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel IsVisible="{Binding HasNoTasks}"
                                Width="360"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <TextBlock Text="{DynamicResource Main.EmptyTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Main.EmptyBody}"
                                   Foreground="{DynamicResource MutedColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <Button Content="{DynamicResource Main.NewTask}"
                                Classes="Primary"
                                Padding="18,8"
                                HorizontalAlignment="Center"
                                Click="BtnAdd_Click"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasNoMatchingVisibleTasks}"
                                Width="360"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="{DynamicResource Main.EmptyFilterTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Main.EmptyFilterBody}"
                                   Foreground="{DynamicResource MutedColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="3"
                    IsVisible="{Binding IsDetailPaneOpen}"
                    Width="340"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource CardBackgroundColor}"
                    Padding="16">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto"
                          Margin="0,0,0,14">
                        <TextBlock Grid.Column="0"
                                   Classes="SectionTitle"
                                   Text="{DynamicResource Main.Details}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="{DynamicResource Main.CollapseDetails}"
                                Padding="10,5"
                                Command="{Binding ToggleDetailPaneCommand}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel IsVisible="{Binding HasNoSelectedTask}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="240"
                                    Spacing="8">
                            <TextBlock Text="{DynamicResource Main.SelectTaskTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Main.SelectTaskBody}"
                                       Foreground="{DynamicResource MutedColor}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer IsVisible="{Binding HasSelectedTask}">
                            <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SelectedTask.FileName}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <Border Grid.Column="1"
                                            Classes="StatusBadge"
                                            Background="{Binding SelectedTask.Status, Converter={StaticResource StatusBackgroundConverter}}">
                                        <TextBlock Classes="StatusBadgeText"
                                                   Text="{Binding SelectedTask.StatusLabel}"
                                                   Foreground="{Binding SelectedTask.Status, Converter={StaticResource StatusForegroundConverter}}"/>
                                    </Border>
                                </Grid>

                                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <ProgressBar Grid.Row="0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="8"
                                                 Value="{Binding SelectedTask.Progress}"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding SelectedTask.Progress, StringFormat={}{0:0.0}%}"
                                               Foreground="{DynamicResource MutedColor}"
                                               FontSize="12"/>
                                </Grid>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource Column.Speed}"/>
                                    <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.Speed}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource Column.Eta}"/>
                                    <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.EtaText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource Column.Size}"/>
                                    <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.FileSize}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{DynamicResource Main.CopyUrl}" Padding="10,5" Click="CopyUrl_Click"/>
                                <Button Content="{DynamicResource Main.CopyPath}" Padding="10,5" Click="CopySavePath_Click"/>
                                <Button Content="{DynamicResource Main.OpenFolder}" Padding="10,5" Click="OpenFolder_Click"/>
                            </StackPanel>

                            <TabControl>
                                <TabItem Header="{DynamicResource Main.Overview}">
                                    <StackPanel Spacing="14" Margin="0,12,0,0">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="FieldLabel" Text="{DynamicResource Field.SavePath}"/>
                                            <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.FullSavePath}"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="FieldLabel" Text="{DynamicResource Field.Url}"/>
                                            <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.Url}"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Classes="FieldLabel" Text="{DynamicResource Field.Threads}"/>
                                                <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.ThreadCount}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Classes="FieldLabel" Text="{DynamicResource Field.BlockSizeMb}"/>
                                                <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.BlockSize}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Classes="FieldLabel" Text="{DynamicResource Field.Mode}"/>
                                                <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.Mode}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Classes="FieldLabel" Text="{DynamicResource Field.FileTime}"/>
                                                <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.UpdateFileTimestampText}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="{DynamicResource Main.Log}">
                                    <StackPanel Spacing="14" Margin="0,12,0,0">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="FieldLabel" Text="{DynamicResource Main.RecentLog}"/>
                                            <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.LogText}"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="FieldLabel" Text="{DynamicResource Main.Diagnostics}"/>
                                            <TextBlock Classes="FieldValue" Text="{Binding SelectedTask.DiagnosticText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="{DynamicResource Main.Headers}">
                                    <TextBox Text="{Binding SelectedTask.HeaderText}"
                                             Margin="0,12,0,0"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             MinHeight="160"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </TabItem>
                            </TabControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}"/>
            </DockPanel>
        </Border>
    </Grid>
</shad:Window>
