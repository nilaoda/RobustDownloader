<shad:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             x:Class="RobustDownloader.Views.AddTaskWindow"
             Title="{DynamicResource Add.Title}"
             Width="660" Height="620"
             MinWidth="560" MinHeight="520"
             WindowStartupLocation="CenterOwner">
    <shad:Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryColor50}"/>
            <Setter Property="SelectionForegroundBrush" Value="{x:Null}"/>
        </Style>
        <Style Selector="TextBlock.Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </shad:Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Add.Title}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Add.Description}"
                       Foreground="{DynamicResource MutedColor}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,0,14,0">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TxtUrlsLabel" Classes="Label" Text="{DynamicResource Add.Urls}"/>
                    <TextBox x:Name="TxtUrls"
                             AcceptsReturn="True"
                             Height="108"
                             TextWrapping="NoWrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextChanged="TxtUrls_TextChanged"/>
                    <TextBlock Classes="Hint" Text="{DynamicResource Add.UrlsHint}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="Label" Text="{DynamicResource Add.SaveDirectory}"/>
                    <Grid ColumnDefinitions="*,8,Auto">
                        <TextBox x:Name="TxtSaveDir"
                                 Grid.Column="0"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="{DynamicResource Add.Browse}"
                                Padding="14,7"
                                Click="BtnBrowse_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="SingleFileNamePanel" Spacing="6">
                    <TextBlock Classes="Label" Text="{DynamicResource Add.FileName}"/>
                    <TextBox x:Name="TxtFileName"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Classes="Hint" Text="{DynamicResource Add.FileNameHint}"/>
                </StackPanel>

                <StackPanel x:Name="BatchFileNamingPanel"
                            Spacing="8"
                            IsVisible="False">
                    <TextBlock Classes="Label" Text="{DynamicResource Add.BatchNaming}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="Label" Text="{DynamicResource Add.BatchNamingMode}"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton x:Name="RdoBatchNamingAuto"
                                         GroupName="BatchNamingMode"
                                         Content="{DynamicResource Add.BatchNamingAuto}"
                                         Click="BatchNaming_Changed"/>
                            <RadioButton x:Name="RdoBatchNamingTemplate"
                                         GroupName="BatchNamingMode"
                                         Content="{DynamicResource Add.BatchNamingTemplate}"
                                         Click="BatchNaming_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="BatchTemplateSettingsPanel" Spacing="8">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="Label" Text="{DynamicResource Add.BatchTemplate}"/>
                            <TextBox x:Name="TxtBatchTemplate"
                                     TextChanged="BatchNaming_Changed"/>
                            <TextBlock Classes="Hint" Text="{DynamicResource Add.BatchTemplateHint}"/>
                        </StackPanel>

                        <Grid x:Name="BatchNumberSettingsPanel"
                              ColumnDefinitions="*,10,*,10,*">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Classes="Label" Text="{DynamicResource Add.BatchStart}"/>
                                <TextBox x:Name="TxtBatchStart"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         TextChanged="BatchNaming_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Classes="Label" Text="{DynamicResource Add.BatchStep}"/>
                                <TextBox x:Name="TxtBatchStep"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         TextChanged="BatchNaming_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="6">
                                <TextBlock Classes="Label" Text="{DynamicResource Add.BatchDigits}"/>
                                <TextBox x:Name="TxtBatchDigits"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         TextChanged="BatchNaming_Changed"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="Label" Text="{DynamicResource Add.BatchPreview}"/>
                            <TextBox x:Name="TxtBatchPreview"
                                     AcceptsReturn="True"
                                     Height="78"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Expander Header="{DynamicResource Add.Advanced}">
                    <StackPanel Spacing="14" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="Label" Text="{DynamicResource Field.Threads}"/>
                                <TextBox x:Name="TxtThreads"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="Label" Text="{DynamicResource Field.BlockSizeMb}"/>
                                <TextBox x:Name="TxtBlock"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Classes="Label" Text="{DynamicResource Add.CustomHeaders}"/>
                            <TextBox x:Name="TxtHeaders"
                                     AcceptsReturn="True"
                                     MinHeight="92"
                                     PlaceholderText="Name: value"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <CheckBox x:Name="ChkUpdateFileTimestamp" Content="{DynamicResource Add.UpdateTimestamp}"/>
                            <CheckBox x:Name="ChkCrcOnly" Content="{DynamicResource Add.CrcOnly}"/>
                            <CheckBox x:Name="ChkSkipCrc" Content="{DynamicResource Add.SkipCrc}"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0"
                Margin="0,16,0,0"
                Padding="0,14,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtValidation"
                           Foreground="{DynamicResource DestructiveColor}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{DynamicResource Add.Cancel}" Padding="18,8" Click="BtnCancel_Click"/>
                    <Button Content="{DynamicResource Add.Enqueue}" Padding="20,8" Classes="Primary" Click="BtnAdd_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</shad:Window>
